<!-- android/app/src/main/AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Health Connect: read-only step count -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- Lets Health Connect show which apps it can talk to (Android 11+) -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application>
        <activity android:name=".MainActivity" android:exported="true">
            <!-- Privacy rationale shown from the Health Connect permission screen -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Android 14+: rationale via activity-alias -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
<!--
  android/app/build.gradle: minSdkVersion 26 (Health Connect requirement).
  MainActivity must extend FlutterFragmentActivity for the health package's permission flow:
    class MainActivity: FlutterFragmentActivity()
-->
