<?xml version="1.0" encoding="utf-8"?>
<!-- Project-local NuGet source for the Windows build (audioplayers_windows fetches
     Microsoft.Windows.ImplementationLibrary). Only applies inside this folder. -->
<configuration>
  <packageSources>
    <add key="nuget.org (evochi)" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
